<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#A2171D26" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#66FFF2E8" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#7A171D26" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#55FFF2E8" />
        </shape>
    </item>
</selector>
