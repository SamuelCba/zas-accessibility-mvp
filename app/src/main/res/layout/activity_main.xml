<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZAS QR Auto"
            android:textColor="#FFF7F3"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Activa accesibilidad y lanza la automatización del formulario QR con seguimiento visual en pantalla."
            android:textColor="#E7D7D0"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_secondary"
            android:elevation="2dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Activar accesibilidad"
            android:textAllCaps="false"
            android:textColor="#FFF7F2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="2dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Iniciar automatización"
            android:textAllCaps="false"
            android:textColor="#6B0209"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
